{
	"name": "render-doc",
	"version": "1.0.7",
	"description": "Render the current note as a LaTeX-typeset academic paper: short citations like (Bonica, 2018: 123) become biblatex \\autocite commands, with a bibliography from Zotero, delivered in its own export folder.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.3",
		"@vitest/coverage-v8": "^4.1.8",
		"esbuild": "0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"prettier": "^3.8.4",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"obsidian": "1.8.7"
	}
}
